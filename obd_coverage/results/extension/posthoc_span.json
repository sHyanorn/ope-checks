{
 "about": "Computed after the results; descriptive and no part of the registered reading. F, FH, FU, FS and FD on All and Women's with the span T of each log chosen by the one-minute ratio at the solved e_S, beside the registered run, which takes it with e_S cut back.",
 "code_commit": "8e37e726e5f5e250c42839fae8fd621d3f9a6498-dirty",
 "numpy": "2.5.4",
 "change": "diff --git a/obd_coverage/extension.py b/obd_coverage/extension.py\nindex 44c4e72..824f373 100644\n--- a/obd_coverage/extension.py\n+++ b/obd_coverage/extension.py\n@@ -186,7 +186,13 @@ def solve_sessions(log, q, e_i, ratios, campaign, i, size, minutes):\n     e_s = min(max(solved, 0), e_i)\n     (n0, n1), (d0, d1) = moments.variance_ratio_moments(log, q, session, e_i, 1)\n     at_one = (n0 + e_s * (n1 - n0)) / (d0 + e_s * (d1 - d0))\n-    return {\"e\": e_s, \"solved\": solved, \"variance_ratio_at_1\": at_one}, session\n+    at_solved = (n0 + solved * (n1 - n0)) / (d0 + solved * (d1 - d0))\n+    return {\n+        \"e\": e_s,\n+        \"solved\": solved,\n+        \"variance_ratio_at_1\": at_one,\n+        \"variance_ratio_at_solved\": at_solved,\n+    }, session\n \n \n def fit_sessions(log, q, e_i, ratios, campaign, i):\n@@ -196,7 +202,7 @@ def fit_sessions(log, q, e_i, ratios, campaign, i):\n             minutes: solve_sessions(log, q, e_i, ratios, campaign, i, size, minutes)[0]\n             for minutes in model.SPANS\n         }\n-        best = min(tried, key=lambda m: abs(tried[m][\"variance_ratio_at_1\"] - ratios[1]))\n+        best = min(tried, key=lambda m: abs(tried[m][\"variance_ratio_at_solved\"] - ratios[1]))\n         if tried[best][\"solved\"] <= e_i or size == SIZES[-1]:\n             return {\"minutes\": best, \"size\": size} | tried[best]\n \n",
